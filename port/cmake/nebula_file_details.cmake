# nebula_file_details(TARGET FILE DESCRIPTION [ICON path] [PRODUCT name] [COMPANY name] [COPYRIGHT text] [DPI_MANIFEST]):
# a Windows program's file details (product Nebula by keepvaibin unless named), its icon (resource 1,
# the game window's) and, with DPI_MANIFEST, a manifest making the process per-monitor DPI aware (v2) from its start. The version is the root CMakeLists.txt project's, read here so the game's module has the same one.
set(NEBULA_RC_TEMPLATE "${CMAKE_CURRENT_LIST_DIR}/nebula_file_details.rc.in")
set(NEBULA_DPI_MANIFEST "${CMAKE_CURRENT_LIST_DIR}/nebula_game.manifest")
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/../CMakeLists.txt" nebula_project_line REGEX "^project\\(Nebula VERSION ")
include("${CMAKE_CURRENT_LIST_DIR}/nebula_options.cmake")
string(REGEX MATCH "([0-9]+)\\.([0-9]+)\\.([0-9]+)" nebula_project_version "${NEBULA_GAME_VERSION}")
set(NEBULA_RC_MAJOR ${CMAKE_MATCH_1})
set(NEBULA_RC_MINOR ${CMAKE_MATCH_2})
set(NEBULA_RC_PATCH ${CMAKE_MATCH_3})

function(nebula_file_details target file description)
    if(NOT WIN32)
        return()
    endif()
    cmake_parse_arguments(arg "DPI_MANIFEST" "ICON;PRODUCT;COMPANY;COPYRIGHT;TRADEMARKS" "" ${ARGN})
    set(NEBULA_RC_FILE "${file}")
    set(NEBULA_RC_PRODUCT "Nebula")
    set(NEBULA_RC_COMPANY "keepvaibin")
    set(NEBULA_RC_COPYRIGHT "Copyright 2026 keepvaibin")
    if(DEFINED arg_PRODUCT)
        set(NEBULA_RC_PRODUCT "${arg_PRODUCT}")
    endif()
    if(DEFINED arg_COMPANY)
        set(NEBULA_RC_COMPANY "${arg_COMPANY}")
    endif()
    if(DEFINED arg_COPYRIGHT)
        set(NEBULA_RC_COPYRIGHT "${arg_COPYRIGHT}")
    endif()
    set(NEBULA_RC_TRADEMARKS "")
    if(DEFINED arg_TRADEMARKS)
        set(NEBULA_RC_TRADEMARKS "${arg_TRADEMARKS}")
    endif()
    set(NEBULA_RC_DESCRIPTION "${description}")
    set(NEBULA_RC_ICON "")
    if(arg_ICON)
        set(NEBULA_RC_ICON "1 ICON \"${arg_ICON}\"")
    endif()
    configure_file("${NEBULA_RC_TEMPLATE}" "${CMAKE_CURRENT_BINARY_DIR}/${target}_details.rc" @ONLY)
    target_sources(${target} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/${target}_details.rc")
    if(arg_DPI_MANIFEST AND MSVC)
        # A .manifest source is merged into the linker's own manifest (/MANIFESTINPUT).
        target_sources(${target} PRIVATE "${NEBULA_DPI_MANIFEST}")
    endif()
endfunction()
